#!/bin/zsh
# Builds build/Margin.app (release, Apple Silicon/Intel native).
set -euo pipefail
cd "${0:A:h}/.."
swift build -c release
APP=build/Margin.app
rm -rf "$APP"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources/Fonts"
cp "$(swift build -c release --show-bin-path)/Margin" "$APP/Contents/MacOS/Margin"
cp Resources/Info.plist "$APP/Contents/Info.plist"
cp Resources/Fonts/* "$APP/Contents/Resources/Fonts/"
if [[ ! -f build/AppIcon.icns ]]; then
  swift bin/make-icon.swift build/AppIcon.iconset Resources/Fonts/IBMPlexMono-Bold.ttf
  iconutil -c icns build/AppIcon.iconset -o build/AppIcon.icns
fi
cp build/AppIcon.icns "$APP/Contents/Resources/AppIcon.icns"
codesign --force --sign - "$APP" >/dev/null
echo "Built $APP"
