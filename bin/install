#!/bin/zsh
# Builds Margin, installs it to ~/Applications, and makes it the default for .md files.
set -euo pipefail
cd "${0:A:h}/.."
./bin/build
DEST="$HOME/Applications/Margin.app"
osascript -e 'tell application id "com.diegogilon.margin" to quit' >/dev/null 2>&1 || true
mkdir -p "$HOME/Applications"
rm -rf "$DEST"
cp -R build/Margin.app "$DEST"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$DEST"
open -a "$DEST" --args --make-default
echo "Installed $DEST"
